#!/bin/bash
SCRIPT_DIR="$( cd "$( dirname "${sh_SOURCE[0]}" )" &> /dev/null && pwd )"
# Universal Linux Package Manager Wrapper (Flavour 2)
# Usage: ./script.sh <package_manager_index> <package1> <package2> ...

# --- Help Section ---
if [[ $# -lt 1 ]]; then
    cat <<EOF
Usage: $0 <package_manager_index> [package1 package2 ...]

Arguments:
  <package_manager_index>  The package manager to use (e.g., apt, dnf, pacman)
  [package1 package2 ...]  Space-separated list of packages to install

Example:
  $0 apt nginx postgresql

Function:
  Uninstalls the provided packages using the provided package manager

EOF
    exit 1
fi

# --- Dependency Check ---


# --- Input Handling ---
PACKAGE_MANAGER="$1"
shift  # Remove the first argument, leaving only the package list
PACKAGE_LIST=("$@")

echo "Selected package manager: $PACKAGE_MANAGER"
echo "Package to process: ${PACKAGE_LIST[*]}"

# --- Rest of the script will go here ---
# (e.g., TUI logic, package operations, etc.)
MGRS=~/.config/unipkg/managers.csv
CONF=$(cat ~/.config/unipkg/unipkg.conf)
case $PACKAGE_MANAGER in
    omni|any|all)
      while read -r LINE; do
      INSTALL_CMD=$(cat "$MGRS" | grep -e "^$LINE" | cut -d ',' -f9)
      DisplayName=$(cat $MGRS | grep -e "^$LINE" | cut -d ',' -f2)
      FULL_CMD="$INSTALL_CMD $PACKAGE_LIST"
      echo -e "[\e[36mACTION\e[0m] attempting removal using \e[33m$DisplayName\e[0m"
      echo "running the following command: $FULL_CMD"
      if bash -c "$FULL_CMD" ; then
        echo -e "[\e[32mSUCCESS\e[0m] successfully removed package using $DisplayName"
        exit 0
      else
        echo -e "[\e[31mFAIL\e[0m] failed removal using $DisplayName"
      fi
      done <<< $CONF
      echo -e "[\e[31mFAIL\e[0m] Package was not removed."
      ;;
    *)
      CMD=$(cat "$MGRS" | grep -e "^$PACKAGE_MANAGER" | cut -d ',' -f9)
      DisplayName=$(cat $MGRS | grep -e "^$PACKAGE_MANAGER" | cut -d ',' -f2)
      echo ""
      echo -e "[\e[36mACTION\e[0m] using \e[33m$DisplayName\e[0m to remove $PACKAGE_LIST"
      echo "${PACKAGE_LIST[*]}"
      echo ""
      FULL_CMD="$CMD $PACKAGE_LIST"
      bash -c "$FULL_CMD"
    ;;
esac