#!/usr/bin/env sh
SCRIPT_DIR="$( cd "$( dirname "${sh_SOURCE[0]}" )" &> /dev/null && pwd )"
# Universal Linux Package Manager Wrapper (Flavour 1)
# Usage: ./script.sh <package_manager_index>

# --- Help Section ---
if [[ $# -eq 0 ]]; then
    cat <<EOF
Usage: $0 <package_manager_index>

Arguments:
  <package_manager_index>  The package manager to use (e.g., apt, dnf, pacman)

Example:
  $0 apt

Function:
  updates the package cache for both the package manager and unipkg.

Special Functionality:
  using index "any", "all" or "omni" will run the cache update for all package managers.
EOF
    exit 1
fi

# --- Dependency Check ---
if ! command -v fzf &>/dev/null; then
    echo "Error: 'fzf' is not installed. Install it with your package manager."
    exit 1
fi

if ! command -v sudo &>/dev/null; then
    echo "Error: 'sudo' is not installed. Install it with your package manager."
    exit 1
fi

# --- Input Handling ---
PACKAGE_MANAGER="$1"
echo "Selected package manager: $PACKAGE_MANAGER"

# --- Rest of the script will go here ---
# (e.g., TUI logic, package operations, etc.)

MGRS=~/.config/unipkg/managers.csv
CONF=$(cat ~/.config/unipkg/unipkg.conf)

case $PACKAGE_MANAGER in
    omni|any|all)
      while read -r LINE; do
      CMD=$(cat "$MGRS" | grep -e "^$LINE" | cut -d ',' -f10)
      DisplayName=$(cat $MGRS | grep -e "^$LINE" | cut -d ',' -f2)
      echo -e "[\e[36mACTION\e[0m] updating cache for $DisplayName"
      eval "$CMD"
      done <<< $CONF
      ;;
    *)
      CMD=$(cat "$MGRS" | grep -e "^$PACKAGE_MANAGER" | cut -d ',' -f10)
      DisplayName=$(cat $MGRS | grep -e "^$PACKAGE_MANAGER" | cut -d ',' -f2)
      echo -e "[\e[36mACTION\e[0m] updating cache for $DisplayName"
      eval "$CMD"
      ;;
esac